# Copy to .env and fill in to run locally: npm run sync:raindancing
#
# For fully hands-off sync, put the same values in GitHub Actions secrets
# (Settings → Secrets and variables → Actions), then the workflow
# .github/workflows/sync-raindancing.yml runs daily and pushes gallery updates.
#
#   gh secret set IG_SESSIONID
#   gh secret set IG_CSRFTOKEN
#   gh secret set CLOUDINARY_URL
#
# Instagram (required to see all posts past the logged-out ~36 limit)
# From browser DevTools → Application → Cookies → instagram.com
# Note: sessionid expires / rotates — when the Action fails, refresh this secret.
IG_SESSIONID=
IG_CSRFTOKEN=

# Cloudinary (required to host new painting images)
# Either:
CLOUDINARY_URL=
# Or:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
